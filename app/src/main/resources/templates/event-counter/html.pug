mixin displayParticipant(cn, email)
  div(style='margin: 4px 0;')
    if (cn && cn !== email)
      b #{cn}
      | &nbsp;
    span(style='color: #5f6368;') #{email}
    if block
      block

mixin displayAttendees(attendees, organizer)
  +displayParticipant(organizer.cn, organizer.email)
    span(style='color: #5f6368;') &nbsp;- #{translator.get('organizer')}
  each attendee, attendeeEmail in attendees
    if (attendeeEmail !== organizer.email)
      +displayParticipant(attendee.cn, attendeeEmail)

mixin section(heading)
  div(style='margin-bottom: 16px;')
    div(style='font-size: 14px; font-weight: 700; margin: 0 0 4px 0;') #{heading}
    div(style='font-size: 14px; line-height: 1.5;')
      block

doctype html
html
  head
    title
    meta(http-equiv='Content-Type' content='text/html; charset=UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    style(type='text/css').
      body {
      margin: 0;
      padding: 0;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
      }
      a {
      color: #1a73e8;
      text-decoration: none;
      }
  body(style='margin: 0; padding: 0; background: #ffffff;')
    div(style='margin: 0 8px 8px 8px; border: 1px solid #e0e0e0; border-radius: 8px; font-family: -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, Helvetica, Arial, sans-serif; color: #1a1a1a;')
      div(style='padding: 16px 16px 0 16px;')
        div(style='display: inline-block; background: #DAECFE; font-size: 13px; line-height: 1.4; padding: 4px 8px; border-radius: 4px; margin-bottom: 8px;')
          b #{content.editorDisplayName}
          | &nbsp;#{translator.get('propose_change_message')}
        if (content.oldEvent)
          div(style='font-size: 18px; font-weight: 600; line-height: 1.3; margin: 0 0 16px 0;') #{content.oldEvent.summary}
        div(style='max-width: 620px;')
          +section(translator.get('proposed_time'))
            if (!content.event.allDay)
              if (content.event.start.date === content.event.end.date)
                | #{content.event.start.fullDateTime} - #{content.event.end.time}
              else
                | #{content.event.start.fullDateTime} - #{content.event.end.fullDateTime}
              span(style='color: #5f6368;') &nbsp;(#{content.event.start.timezone})
            else
              if (content.event.start.date === content.event.end.date)
                | #{content.event.start.fullDate} (#{translator.get('all_day')})
              else
                | #{content.event.start.fullDate} - #{content.event.end.fullDate} (#{translator.get('all_day')})
            if (content.seeInCalendarLink)
              | &nbsp;
              a(href=content.seeInCalendarLink style='color: #1a73e8; text-decoration: none;') #{translator.get('see_in_calendar')}
          if (content.event.comment)
            +section(translator.get('comment'))
              div(style='white-space: pre-line;') #{content.event.comment}
          if (content.oldEvent)
            +section(translator.get('current_time'))
              if (!content.oldEvent.allDay)
                if (content.oldEvent.start.date === content.oldEvent.end.date)
                  | #{content.oldEvent.start.fullDateTime} - #{content.oldEvent.end.time}
                else
                  | #{content.oldEvent.start.fullDateTime} - #{content.oldEvent.end.fullDateTime}
                span(style='color: #5f6368;') &nbsp;(#{content.oldEvent.start.timezone})
              else
                if (content.oldEvent.start.date === content.oldEvent.end.date)
                  | #{content.oldEvent.start.fullDate} (#{translator.get('all_day')})
                else
                  | #{content.oldEvent.start.fullDate} - #{content.oldEvent.end.fullDate} (#{translator.get('all_day')})
            if (content.oldEvent.location)
              +section(translator.get('where'))
                if (content.oldEvent.location.isValidURL)
                  if (content.oldEvent.location.isAbsoluteURL)
                    a(href=content.oldEvent.location.value style='color: #1a73e8; text-decoration: none;') #{content.oldEvent.location.value}
                  else
                    a(href=`//${content.oldEvent.location.value}` style='color: #1a73e8; text-decoration: none;') #{content.oldEvent.location.value}
                else
                  | #{content.oldEvent.location.value}&nbsp;
                  a(href=`https://www.openstreetmap.org/search?query=${content.oldEvent.location.urlEncodedValue}` style='color: #1a73e8; text-decoration: none;') #{translator.get('see_in_map')}
            +section(translator.get('participants'))
              +displayAttendees(content.oldEvent.attendees, content.oldEvent.organizer)
            if (content.oldEvent.hasResources)
              +section(translator.get('resources'))
                | #{content.oldEvent.resourcesJoined}
            if (content.oldEvent.description)
              +section(translator.get('notes'))
                div(style='white-space: pre-line;') #{content.oldEvent.description}

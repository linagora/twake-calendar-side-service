doctype html
html.mail
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
  body(style="margin: 0; background-color: #EEEEEE;")
    table(align="center" width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background-color: #EEEEEE;")
      tr
        td(align="center" style="padding: 24px 12px;")
          table.wrapper.mail-content(width="600" cellpadding="0" cellspacing="0" role="presentation" style="width: 100%; max-width: 600px; background-color: white; border-radius: 5px;")
            tr
              td(style="padding: 24px; text-align: left; font-family: Arial, sans-serif; font-size: 14px; line-height: 21px; color: #222222;")
                .logo(style="margin-bottom: 20px;")
                  a(href=content.baseUrl)
                    img(src="cid:logo" alt="Twake Contacts Logo" width="210" height="30" style="display: block; width: 210px; height: 30px; border: 0;")
                h2.title(style="margin: 0 0 16px; font-size: 22px; line-height: 28px; font-weight: bold;") #{translator.get('header')}
                .import
                  p(style="margin: 0 0 12px;") #{translator.get('completed_message')}
                  ul(style="margin: 0; padding-left: 20px;")
                    li #{content.jobSucceedCount} #{translator.get('import_success')}
                    li #{content.jobFailedCount} #{translator.get('import_failure')}
                if content.jobFailedCount
                  .failed(style="margin-top: 20px;")
                    p(style="margin: 0 0 12px;") #{translator.get('import_failure_list')}
                    ul(style="margin: 0; padding-left: 20px;")
                      each contact in content.jobFailedList
                        li #{contact.email}
mixin displayParticipant(cn, email)
  div(style='margin: 4px 0;')
    if (cn)
      b #{cn}
      | &nbsp;
    span(style='color: #5f6368;') #{email}
    if block
      block

mixin displayAttendees(attendees, organizer)
  +displayParticipant(organizer.cn, organizer.email)
    span(style='color: #5f6368;') &nbsp;- #{translator.get('organizer')}
  each attendee, attendeeEmail in attendees
    if (attendeeEmail !== organizer.email)
      +displayParticipant(attendee.cn, attendeeEmail)

mixin displayResources(resources)
  - var first = true;
  span
    each resource, key in resources
      if !first
        | ,&nbsp;
      = resource.cn
      - first = false

mixin changeTag(label)
  span(style='display: inline-block; vertical-align: middle; margin-left: 6px; padding: 1px 6px; background: #fef7e0; color: #b06000; font-size: 12px; font-weight: 600; line-height: 1.4; border-radius: 4px;') #{label}

mixin previousValue
  div(style='margin-top: 2px; font-size: 12px; color: #5f6368; text-decoration: line-through;')
    block

mixin section(heading, tag)
  div(style='margin-bottom: 16px;')
    div(style='font-size: 14px; font-weight: 700; margin: 0 0 4px 0;')
      | #{heading}
      if (tag)
        +changeTag(tag)
    div(style='font-size: 14px; line-height: 1.5;')
      block

mixin rsvpButton(link, label)
  td(style='padding: 4px 4px 0 0;')
    a(href=link target='_blank' style='display: inline-block; padding: 6px 18px; border: 1px solid #c9c9c9; border-radius: 999px; background: #ffffff; color: #1a1a1a; font-size: 14px; text-align: center; text-decoration: none; white-space: nowrap;') #{label}

mixin previousTime(changes, event)
  if (!changes.isOldEventAllDay)
    if (changes.dtstart && changes.dtend)
      if (changes.dtstart.previous.date === changes.dtend.previous.date)
        | #{changes.dtstart.previous.fullDateTime} - #{changes.dtend.previous.time}
      else
        | #{changes.dtstart.previous.fullDateTime} - #{changes.dtend.previous.fullDateTime}
    else if (!changes.dtstart)
      if (event.start.date === changes.dtend.previous.date)
        | #{event.start.fullDateTime} - #{changes.dtend.previous.time}
      else
        | #{event.start.fullDateTime} - #{changes.dtend.previous.fullDateTime}
    else
      if (changes.dtstart.previous.date === event.end.date)
        | #{changes.dtstart.previous.fullDateTime} - #{event.end.time}
      else
        | #{changes.dtstart.previous.fullDateTime} - #{event.end.fullDateTime}
  else
    if (changes.dtstart && changes.dtend)
      if (changes.dtstart.previous.date === changes.dtend.previous.date)
        | #{changes.dtstart.previous.fullDate} (#{translator.get('all_day')})
      else
        | #{changes.dtstart.previous.fullDate} - #{changes.dtend.previous.fullDate} (#{translator.get('all_day')})
    else if (!changes.dtstart)
      if (event.start.date === changes.dtend.previous.date)
        | #{event.start.fullDate} (#{translator.get('all_day')})
      else
        | #{event.start.fullDate} - #{changes.dtend.previous.fullDate} (#{translator.get('all_day')})
    else
      if (changes.dtstart.previous.date === event.end.date)
        | #{changes.dtstart.previous.fullDate} (#{translator.get('all_day')})
      else
        | #{changes.dtstart.previous.fullDate} - #{event.end.fullDate} (#{translator.get('all_day')})

doctype html
html
  head
    title
    meta(http-equiv='Content-Type' content='text/html; charset=UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    style(type='text/css').
      body {
      margin: 0;
      padding: 0;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
      }
      a {
      color: #1a73e8;
      text-decoration: none;
      }
      @media only screen and (min-width: 720px) {
      .col-left {
      width: 66% !important;
      }
      .col-right {
      width: 34% !important;
      }
      .conference-box {
      max-width: none !important;
      background: transparent !important;
      padding: 0 0 0 16px !important;
      text-align: right !important;
      }
      .join-desktop {
      display: inline-block !important;
      }
      .join-mobile {
      display: none !important;
      }
      }
  body(style='margin: 0; padding: 0; background: #ffffff;')
    div(style='margin: 0 8px 8px 8px; border: 1px solid #e0e0e0; border-radius: 8px; font-family: -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, Helvetica, Arial, sans-serif; color: #1a1a1a;')
      div(style='padding: 16px 16px 0 16px;')
        div(style='font-size: 0;')
          div.col-left(style='display: inline-block; vertical-align: top; width: 100%; font-size: 14px;')
            div(style='display: inline-block; background: #fef7e0; font-size: 13px; line-height: 1.4; padding: 4px 8px; border-radius: 4px; margin-bottom: 8px;')
              b #{content.event.organizer.cn}
              | &nbsp;#{translator.get('update_event')}
            div(style='margin: 0 0 16px 0;')
              div(style='font-size: 18px; font-weight: 600; line-height: 1.3;')
                if (content.event.summary)
                  | #{content.event.summary}
                else
                  | #{translator.get('no_title')}
                if (content.changes && content.changes.summary)
                  +changeTag(translator.get('changed'))
              if (content.changes && content.changes.summary)
                +previousValue
                  if (content.changes.summary.previous)
                    | #{content.changes.summary.previous}
                  else
                    | #{translator.get('no_title')}
          if (content.event.videoConferenceLink)
            div.col-right(style='display: inline-block; vertical-align: top; width: 100%; font-size: 14px;')
              div.conference-box(style='box-sizing: border-box; max-width: 400px; margin-bottom: 16px; padding: 14px; background: #f8f9fa; border-radius: 8px; text-align: left;')
                a.join-desktop(href=content.event.videoConferenceLink target='_blank' style='display: none; mso-hide: all; margin-bottom: 18px; padding: 10px 18px; background: #1a73e8; color: #ffffff; font-size: 14px; font-weight: 500; border-radius: 6px; text-decoration: none; white-space: nowrap;') #{translator.get('join_video_conference')}
                div(style='font-size: 14px; font-weight: 700; margin: 0 0 6px 0;') #{translator.get('video_conference')}
                a(href=content.event.videoConferenceLink target='_blank' style='font-size: 14px; color: #1a73e8; text-decoration: none; word-break: break-all;') #{content.event.videoConferenceLink}
                a.join-mobile(href=content.event.videoConferenceLink target='_blank' style='display: block; margin-top: 12px; padding: 10px 16px; background: #1a73e8; color: #ffffff; font-size: 14px; font-weight: 600; text-align: center; border-radius: 20px; text-decoration: none;') #{translator.get('join_video_conference')}
        div(style='max-width: 620px;')
          - var timeChanged = content.changes && ((content.changes.dtstart && content.changes.dtstart.previous.fullDateTime !== content.event.start.fullDateTime) || (content.changes.dtend && content.changes.dtend.previous.fullDateTime !== content.event.end.fullDateTime))
          +section(translator.get('when'), timeChanged ? translator.get('changed') : null)
            if (!content.event.allDay)
              if (content.event.start.date === content.event.end.date)
                | #{content.event.start.fullDateTime} - #{content.event.end.time}
              else
                | #{content.event.start.fullDateTime} - #{content.event.end.fullDateTime}
              span(style='color: #5f6368;') &nbsp;(#{content.event.start.timezone})
            else
              if (content.event.start.date === content.event.end.date)
                | #{content.event.start.fullDate} (#{translator.get('all_day')})
              else
                | #{content.event.start.fullDate} - #{content.event.end.fullDate} (#{translator.get('all_day')})
            if (content.seeInCalendarLink)
              | &nbsp;
              a(href=content.seeInCalendarLink style='color: #1a73e8; text-decoration: none;') #{translator.get('see_in_calendar')}
            if (timeChanged)
              +previousValue
                +previousTime(content.changes, content.event)
          if (content.event.location)
            - var locationTag = content.changes && content.changes.location ? (content.changes.location.previous ? translator.get('changed') : translator.get('added')) : null
            +section(translator.get('where'), locationTag)
              if (content.event.location.isLocationAValidURL)
                if (content.event.location.isLocationAnAbsoluteURL)
                  a(href=content.event.location.value style='color: #1a73e8; text-decoration: none;') #{content.event.location.value}
                else
                  a(href=`//${content.event.location.value}` style='color: #1a73e8; text-decoration: none;') #{content.event.location.value}
              else
                | #{content.event.location.value}&nbsp;
                a(href=`https://www.openstreetmap.org/search?query=${content.event.location.urlEncodedValue}` style='color: #1a73e8; text-decoration: none;') #{translator.get('see_in_map')}
              if (content.changes && content.changes.location && content.changes.location.previous)
                +previousValue
                  | #{content.changes.location.previous}
          else if (content.changes && content.changes.location && content.changes.location.previous)
            +section(translator.get('where'), translator.get('removed'))
              +previousValue
                | #{content.changes.location.previous}
          +section(translator.get('participants'))
            +displayAttendees(content.event.attendees, content.event.organizer)
          if (content.event.hasResources)
            +section(translator.get('resources'))
              +displayResources(content.event.resources)
          +section(translator.get('attend_event'))
            table(role='presentation' border='0' cellpadding='0' cellspacing='0' style='border-collapse: collapse;')
              tr
                +rsvpButton(content.yesLink, translator.get('yes'))
                +rsvpButton(content.noLink, translator.get('no'))
                +rsvpButton(content.maybeLink, translator.get('maybe'))
          if (content.event.description)
            - var descriptionTag = content.changes && content.changes.description ? (content.changes.description.previous ? translator.get('changed') : translator.get('added')) : null
            +section(translator.get('notes'), descriptionTag)
              div(style='white-space: pre-line;') #{content.event.description}
              if (content.changes && content.changes.description && content.changes.description.previous)
                +previousValue
                  div(style='white-space: pre-line;') #{content.changes.description.previous}
          else if (content.changes && content.changes.description && content.changes.description.previous)
            +section(translator.get('notes'), translator.get('removed'))
              +previousValue
                div(style='white-space: pre-line;') #{content.changes.description.previous}
      div(style='border-top: 1px solid #e0e0e0; padding: 16px; font-size: 12px; line-height: 1.6; color: #5f6368;')
        p(style='margin: 0;') #{translator.get('forward_warning')}
